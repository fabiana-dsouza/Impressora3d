# Copie este arquivo para .env.local e preencha com os dados do SEU projeto.
# Onde achar: supabase.com -> seu projeto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://mwlsmghitgzmuuqgjzmu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uLKyTRshaXAP5_96Pa252Q_-R26Pmer

# ---- Pagamentos (só a pessoa adulta responsável configura) ----

# Chave "service_role" do Supabase (Settings -> API -> service_role).
# É SECRETA: só vive no servidor, nunca no navegador. O webhook usa ela
# pra marcar quem pagou.
SUPABASE_SERVICE_ROLE_KEY=

# Token do Mercado Pago (mercadopago.com.br -> Suas integrações ->
# criar aplicação -> Credenciais de produção -> Access Token).
MP_ACCESS_TOKEN=

# Endereço público do site (depois do deploy na Vercel).
# É pra onde o Mercado Pago devolve a pessoa após pagar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️ ESTE É O MODELO — VAI PRO GITHUB. NUNCA PONHA SENHA DE VERDADE AQUI!
#
# As chaves de verdade vão no arquivo  .env.local  (esse não vai pro git).
# Pra começar:   cp .env.local.example .env.local   e preencha o .env.local.

# ---- Supabase (Settings -> API) ----
# Estas duas são públicas (aparecem no navegador de qualquer jeito).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# ---- Segredos (só no servidor, NUNCA no navegador) ----

# Supabase -> Settings -> API -> service_role.
# O webhook usa ela pra marcar quem pagou.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago -> Suas integrações -> sua aplicação ->
# Credenciais de produção -> Access Token (começa com APP_USR-).
MP_ACCESS_TOKEN=

# ---- Endereço público do site ----
# Local: http://localhost:3000 | Publicado: https://seu-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
